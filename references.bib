@article{moslehMisinformationHarmfulLanguage2024,
	title = {Misinformation and harmful language are interconnected, rather than distinct, challenges},
	volume = {3},
	issn = {2752-6542},
	url = {https://doi.org/10.1093/pnasnexus/pgae111},
	doi = {10.1093/pnasnexus/pgae111},
	abstract = {There is considerable concern about users posting misinformation and harmful language on social media. Substantial—yet largely distinct—bodies of research have studied these two kinds of problematic content. Here, we shed light on both research streams by examining the relationship between the sharing of misinformation and the use of harmful language. We do so by creating and analyzing a dataset of 8,687,758 posts from N = 6,832 Twitter (now called X) users, and a dataset of N = 14,617 true and false headlines from professional fact-checking websites. Our analyses reveal substantial positive associations between misinformation and harmful language. On average, Twitter posts containing links to lower-quality news outlets also contain more harmful language (β = 0.10); and false headlines contain more harmful language than true headlines (β = 0.19). Additionally, Twitter users who share links to lower-quality news sources also use more harmful language—even in non-news posts that are unrelated to (mis)information (β = 0.13). These consistent findings across different datasets and levels of analysis suggest that misinformation and harmful language are related in important ways, rather than being distinct phenomena. At the same, however, the strength of associations is not sufficiently high to make the presence of harmful language a useful diagnostic for information quality: most low-quality information does not contain harmful language, and a considerable fraction of high-quality information does contain harmful language. Overall, our results underscore important opportunities to integrate these largely disconnected strands of research and understand their psychological connections.},
	number = {3},
	urldate = {2024-03-26},
	journal = {PNAS Nexus},
	author = {Mosleh, Mohsen and Cole, Rocky and Rand, David G},
	month = mar,
	year = {2024},
	keywords = {read},
	pages = {pgae111},
	annote = {Summary
The authors analyze the relationship between hate speech and misinformation. They argue that so far, it’s been treated separately, both by researchers and platform designer, but that the psychological mechanisms might be the same/intertwined. However, they don’t go on to explaining the mechanisms. 
In order to explore this relationship, they analyze Twitter data from users who follow at least 3 political figures or organizations and who have shared at least one domain with trustworthiness rating as well as headlines that are true and false. They use a bunch of pre-trained classifiers to get hate speech, gender, age, political affilication, bots
-{\textgreater} Validation or argumentation why? Baselines?
First, they analyze all posts containing a link, and find a positive relationship. Second, they reproduce this finding analyzing users who have shared at least one URL, by taking the aggregate trustworthiness/hatefulness per user across all posts they shared. 
“Our sample includes N=6,832 users who shared at least one link from websites for which we have trustworthiness ratings. We analyzed 8,687,758 posts of which 198,508 posts contained a link to rated news websites.”
-{\textgreater} What if someone shared only one link?
Lastly, they analyze 14,617 news headlines that were rated false/true by fact-checkers and also reproduce the finding (10,672 were false and 3,945 were true). 
Conclusions


Misinformation and hate speech are related and the underlying causal mechanisms should be studied in uniform.


But this association is weak; misinformation sometimes doesn’t contain hate speech and also true information sometimes contains hate speech.





