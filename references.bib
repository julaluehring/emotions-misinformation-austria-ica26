	year = {2021},
	keywords = {misinformation, read, emotion, context dependent, rumor},
	pages = {51},
	annote = {topics: business, science, politics
emotional effect possibly context specific},
	file = {Pröllochs et al. - 2021 - Emotions in online rumor diffusion.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\MSZSETNU\\Pröllochs et al. - 2021 - Emotions in online rumor diffusion.pdf:application/pdf},
