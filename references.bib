@article{balluffAustrianPoliticalAdvertisement2026,
	address = {Los Angeles, CA},
	title = {The {Austrian} {Political} {Advertisement} {Scandal}: {Patterns} of “{Journalism} for {Sale}”},
	volume = {31},
	issn = {1940-1612},
	shorttitle = {The {Austrian} {Political} {Advertisement} {Scandal}},
	doi = {10.1177/19401612241285672},
	abstract = {Mounting concern surrounds the influence of political actors on journalism, especially as media outlets face increasing financial pressures. These circumstances can give rise to instances of media capture, a mutually corrupting relationship between political actors and media organizations. However, empirical evidence substantiating such mechanisms and their consequences remains limited, particularly in the context of Western democracies. This chapter investigates a recent case in which a former Austrian chancellor allegedly colluded with a tabloid newspaper to receive better news coverage in exchange for increased ad placements by government institutions. We employ automated content analysis to investigate political news articles from seventeen prominent Austrian news outlets spanning 2012–2021 (n = 222,659). Adopting a difference-in-differences approach, we find a substantial increase in media visibility of the former Austrian chancellor within the news outlet that is alleged to have received bribes, as well as a decrease in favorability for challenger candidates. Although this study does not aim to prove or disprove the involvement of specific political actors or media organizations in unethical or illegal activities, it introduces an innovative method for detecting unusual patterns in media reporting. Findings are discussed in the context of current threats to media independence and underscore the crucial need to protect journalistic integrity and ensure unbiased information for the public.},
	language = {eng},
	number = {1},
	journal = {The international journal of press/politics},
	publisher = {SAGE Publications},
	author = {Balluff, Paul and Eberl, Jakob-Moritz and Oberhänsli, Sarina Joy and Bernhard-Harrer, Jana and Boomgaarden, Hajo G. and Fahr, Andreas and Huber, Martin},
	year = {2026},
	keywords = {Ethics, Journalism, Advertising, Bias, Bribery, Mass media, Press, Press coverage, Scandals, Visibility},
	pages = {91--117},
	file = {Full Text:C\:\\Users\\luehrija\\Zotero\\storage\\GGGKSTIC\\Balluff et al. - 2026 - The Austrian Political Advertisement Scandal Patterns of “Journalism for Sale”.pdf:application/pdf},
