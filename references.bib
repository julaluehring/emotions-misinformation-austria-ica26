}

@article{houbenRelationShorttermEmotion2015,
	title = {The relation between short-term emotion dynamics and psychological well-being: {A} meta-analysis.},
	volume = {141},
	issn = {1939-1455, 0033-2909},
	shorttitle = {The relation between short-term emotion dynamics and psychological well-being},
	url = {https://doi.apa.org/doi/10.1037/a0038822},
	doi = {10.1037/a0038822},
	language = {en},
	number = {4},
	urldate = {2025-10-02},
	journal = {Psychological Bulletin},
	author = {Houben, Marlies and Van Den Noortgate, Wim and Kuppens, Peter},
	month = jul,
	year = {2015},
	keywords = {read},
	pages = {901--930},
	annote = {This meta-study tests the associations between emotional dynamics (defined by variability, instability, and inertia) with psychological well-being.
The researchers find 1) emotional dynamics are related to psychological well-being and are equally as important as static emotions measures, 2) the time period doesn’t matter (but they only did seconds to days), 3) “more variable, unstable, and more inert emotions are indicative of psychological maladjustment;” (Houben et al., 2015, p. 926), 4) this is stronger for negative emotions. 
The authors strongly suggest using more time series data, also digital data, to analyze emotions and theoretically link this to Frijda’s emotion theory: “Although this research has indisputably produced important insights, it has largely neglected the inherent time-dynamic nature of emotions. Indeed, emotions are not constant and unchanging over time, but continuously fluctuate as a result of internal or external events (Frijda, 2007). In fact, the very function of emotions lies in their time-dynamic nature, namely to alert us to important changes in the environment and motivate us to deal with these changes (Frijda, 2007; Scherer, 2009). The traditional approach linking emotions as static entities to psychological wellbeing has therefore provided only a limited perspective. With as much as we have learned about emotions, it is as if we have been taking still photos of a dance.” (Houben et al., 2015, p. 902)
},
	file = {PDF:C\:\\Users\\luehrija\\Zotero\\storage\\4U4EWGTE\\Houben et al. - 2015 - The relation between short-term emotion dynamics and psychological well-being A meta-analysis..pdf:application/pdf},
}

@article{robertsonHowSocialIdentity2022,
	title = {How {Social} {Identity} {Shapes} {Conspiratorial} {Belief}},
	issn = {2352-250X},
	url = {https://www.sciencedirect.com/science/article/pii/S2352250X22001440},
	doi = {10.1016/j.copsyc.2022.101423},
	abstract = {While conspiracy theories may offer benefits to those who believe in them, they can also foster intergroup conflict, threaten democracy, and undercut public health. We argue that the motivations behind conspiracy theory belief are often related to social identity. Conspiracy theories are well-positioned to fulfill social identity needs such as belongingness goals, the need to think highly of one’s in-group, and the need to feel secure in one’s group status. Understanding the social motives that attract people to conspiracy theories should be a focus of future research, and may be key to creating more successful interventions to reduce socially harmful conspiracy theories.},
	language = {en},
	urldate = {2022-07-27},
	journal = {Current Opinion in Psychology},
	author = {Robertson, Claire E. and Pretus, Clara and Rathje, Steve and Harris, Elizabeth and Van Bavel, Jay J.},
	month = jul,
	year = {2022},
	keywords = {read, Misinformation, Conspiracy theories, Conspiracy Theories, Intergroup Relations, need to belong, Social identity, Social Identity},
	pages = {101423},
	annote = {Quote

Many prior interventions for conspiracy and misinforma-tion belief have focused on inducing people to be moti-vated to be more accurate [29,38]. However, theseinterventions may be less effective for extreme partisans([34,35]; [32]). Our proposed framework suggests thatconspiracy theories are, at least in part, responses togroup-based threats. Therefore, identity-based motiva-tions may outweigh individual motivations in conspiracytheory belief and sharing. For example, people reporthigher intentions to share conspiracy theories they knowmay be inaccurate online when they anticipate high socialreward, suggesting that identity-based goals might beimportant to consider when mitigating the spread ofconspiracy theories [36]. Prior work has also found thatpeople can change their behavioral motivations whendifferent social identities are activated [46,45]. Thus, interventions that highlight a person’s social identity (i.e.their identity as a teacher or doctor rather than as aQAnon believer) or highlight accuracy norms and in-centives may help combat conspiracy theory belief.

},
	file = {Robertson et al. - 2022 - How social identity shapes conspiratorial belief.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\5F8UYHYK\\Robertson et al. - 2022 - How social identity shapes conspiratorial belief.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\luehrija\\Zotero\\storage\\B8P3JEAZ\\S2352250X22001440.html:text/html},
}

@incollection{stecklerEmotionalUnderpinningsSocial2014,
	address = {New York, NY},
	title = {The {Emotional} {Underpinnings} of {Social} {Status}},
	isbn = {978-1-4939-0867-7},
	url = {https://doi.org/10.1007/978-1-4939-0867-7_10},
	doi = {10.1007/978-1-4939-0867-7_10},
	abstract = {Emotions influence social status in a number of ways. Here, we adopt an evolutionary approach to examine the ways in which certain distinct emotions function to facilitate navigation of the status hierarchy. We argue that these emotions affect status outcomes through three distinct pathways: their experience, their nonverbal display, and the way their displays are perceived in others. We review evidence for each of these pathways, for several distinct emotions previously examined in the context of status attainment, status communication, or hierarchy navigation; these include certain highly social emotions (i.e., pride, shame, envy, contempt, and admiration) and more “basic” emotions (i.e., happiness, sadness, anger, disgust, and fear/anxiety). Together, the reviewed findings offer a number of insights regarding the importance of emotions for status negotiation processes, but considerable work remains, and we hope this review will serve as a foundation for future studies examining these issues from functionalist and evolutionary perspectives.},
	language = {en},
	urldate = {2022-09-27},
	booktitle = {The {Psychology} of {Social} {Status}},
	publisher = {Springer},
	author = {Steckler, Conor M. and Tracy, Jessica L.},
	editor = {Cheng, Joey T. and Tracy, Jessica L. and Anderson, Cameron},
	year = {2014},
	keywords = {read, Emotions, Evolution, Hierarchy, review/meta-analysis, Social rank, Status},
	pages = {201--224},
	annote = {Annotations - Summary
Three Ways in Which Emotions Influence Social Status  


experience of a given emotion  


Emotions influence status-related behaviors through both informational (i.e., affect-as-information; Schwarz \& Clore, 1983, 1988) and motivational means  


informational: gain information from the environment and adjust behavior


motivational views suggest that emotions have direct motivational force  




nonverbal displays of emotion influence social status by communicating status relevant information  


signals,”: evolved to communicate status


cues,”: implicit communication of status




emotions influence hierarchical relationships when they are perceived in others who show status-related emotional displays.


perceivers can adjust their behavior in an adaptive manner,  





Emotion: include subjective feelings, physiological changes, cognitive appraisals, and motivated action tendencies or behaviors


socially complex emotions include pride, shame, envy, contempt, and admiration  


status-relevant basic emotions are: happiness, sadness, anger, disgust, and fear.  


Pride  


socially valued successes caused by the self  (Steckler and Tracy, 2014, p. 6)


likely evolved largely for the purpose of enhancing and maintaining social status  


pride subjective experience motivates individuals to strive for achievements in socially valued domains.  


distinguish between the pride that promotes hard work and achievement motivation and is based on accomplishments and confidence, and a pride that is based on arrogance and egotism, associated with self-aggrandizement and a sense of superiority  


authentic pride”  


hubristic pride  




humans evolved to seek and attain two distinct forms of high status:  


Dominance, achieved through force, threat, and intimidation (i.e., fear-based status)  


Prestige, granted on the basis of demonstrated”


knowledge, skills, and altruism (  






hubristic pride is positively associated with narcissism  


associations between authentic pride and pro-social behavior, empathy, agreeableness, conscientiousness, and moral action  


pride expression is rapidly and automatically perceived to communicate high status,  


pride displayers may be particularly likely to respond aggressively to status challenges  


Shame  


when individuals experience failure in achievement or social contexts, and attribute their failure to something stable about who they are  (Steckler and Tracy, 2014, p. 12)


emotion that lowers self-esteem and can promote anger, resentment, and even addictive behaviors  


shame displays are automatically perceived as communicating low status  


Appeasement is essential to the long-term survival of interpersonal relationships, and to the maintenance of one’s place within a social group (i.e., avoiding social rejection)  


In sum, the shame expression may have evolved as a functional social signal, to inform onlookers of: (a) a transgressing individual’s awareness that social norms have been violated, and (b) his or her respect for those norms.  


likely increases perceptions of trustworthiness;  


Individuals who are perceived as trustworthy will, in contrast, be included in social groups, and will benefit from this membership by acquiring access to shared social and material resources.  (Steckler and Tracy, 2014, p. 15)


perceiving shame displays in others, observers learn which group members are relatively lower in status  


deferring less to these individuals or being more assertive and demanding of them.  


Envy  


When individuals view others as high in competence but low in warmth, they tend to feel envy  


a negative emotion experienced in response to another’s higher status or costly possessions  


envy appears to motivate people to change a status quo they do not like or perceive as unjust, either by seeking to increase their own status or reduce the status of another.  (Steckler and Tracy, 2014, p. 17)


those who experience envy are typically unwilling to accept their relatively lower status, and instead seek to improve it  


Contempt


in response to another’s failure to uphold his or her duties to the group or to properly respect the social order  


when individuals perceive others as low in competence and warmth  


affective information to the experiencer that the target of his or her contempt deserves lower status  





Admiration  


When individuals perceive others as high in competence and high in warmth  


increasing one’s proximity to the admired  


Happiness  


Studies that have used socioeconomic status (SES) as a proxy for status have documented only a weak positive relation between SES and happiness  (Steckler and Tracy, 2014, p. 19)


happiness may motivate status seeking, under the assumption that increased status will lead to increased happiness,  


positive experiences produce a happiness that is fairly short lived  


forecasted happiness,  


stronger correlation between local status (i.e., sociometric status) and happiness  


respect and admiration within one’s local group, but not socioeconomic status, predict subjective wellbeing,  


subjective experiences of happiness can promote status increases.  


Sadness/Melancholia/Depression  


First, sadness can serve as an intrapersonal status attainment brake  (Steckler and Tracy, 2014, p. 22)


in response to unattainable goals, and provide psychological and physiological encouragement to desist goal pursuit  


Second, sadness may function as an interpersonal yielding strategy  


sadness follows directly from a status loss and works to keep the low-status individual submissive  


may prevent low-status individuals from seeking out opportunities that would put them within high-status individuals’ radars  


Individuals who display sadness are perceived as low in dominance (Knutson, 1996),  


it is unclear whether sadness displays are signals of status loss or cue low status for culture-specific reasons, such as gender norms about the appropriateness of certain displays  


these individuals need not be considered serious status competitors, at least while they are displaying (and thus presumably experiencing) sadness.  


the display may also indicate an opportunity to help the individual, and thereby strengthen the interpersonal relationship.  


Anger  


preserve or enhance self-esteem against assault  (Steckler and Tracy, 2014, p. 24)


violation of justice or fairness  


anger may function, in part, to inform individuals that their current social ranking is unjust and should be changed or fought  


motivated to punish the individual subjecting them to unfairness  


recalibration theory of anger’ (Sell, 2011)  


anger functions to resolve conflicts of interest to the benefit of the experiencer by motivating behaviors, such as aggression, that cause others to ‘recalibrate’ and treat the angry individual better  


Nonverbal displays of anger have been found to communicate high status  


anger displays are not as strongly associated with high  


status as are pride displays (Shariff \& Tracy, 2009)


anger may be particularly relevant to status perceptions in the Western part of the world  


Disgust  


emotional response to social events that are perceived to be metaphorically nauseating  (Steckler and Tracy, 2014, p. 26)


dissuading individuals from assenting to a suggested status quo or providing information that tracks unfairness.  


toward individuals who are low in competence and warmth  


and can motivate avoidance of those individuals,  


hose who display disgust are perceived as high in status (Knutson, 1996)  


status-relevant communication function of disgust likely occurs as a result of cueing rather than signaling  


Fear and Anxiety  


fear is typically considered a more intense or shorter-lived version of anxiety  


experience of fear or anxiety may promote monitoring of social situations in which the threat of a status loss or social exclusion is possible  


prevent thes  


individuals low in status may be particularly motivated to behave cautiously in situations that could result in punishment.  


Displaying fear as a signal of one’s relatively lower status is common among some non-human animals  


can spare both parties from potentially costly conflicts.  


Limitations  
Culture


Are the Status-Related Functions of Emotions Universal?  


North Americans suppress the display or experience of shame  


at least in the highly public situation of loss at the Olympic Games. It would be incorrect to infer from these results that North Americans do not display shame in response to failure  


Status and Emotion Among Non-Strangers and With Repeated Interactions  


Most real-world status-relevant interactions occur between co-workers, friends, family members, or acquaintances  


In real-world relationships, individuals typically have a pre-existing sense of each other’s relative rank, independent of the information conveyed by an emotion diplay  


Studies are thus needed to examine the relevance of emotion expressions on hierarchy in more ecologically valid contexts  


},
	file = {Steckler and Tracy - 2014 - The Emotional Underpinnings of Social Status.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\445CMHYD\\Steckler and Tracy - 2014 - The Emotional Underpinnings of Social Status.pdf:application/pdf},
}

