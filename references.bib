@article{widmannCreatingComparingDictionary2022,
	title = {Creating and {Comparing} {Dictionary}, {Word} {Embedding}, and {Transformer}-{Based} {Models} to {Measure} {Discrete} {Emotions} in {German} {Political} {Text}},
	issn = {1047-1987, 1476-4989},
	url = {https://www.cambridge.org/core/journals/political-analysis/article/creating-and-comparing-dictionary-word-embedding-and-transformerbased-models-to-measure-discrete-emotions-in-german-political-text/2DA41C0F09DE1CA600B3DCC647302637},
	doi = {10.1017/pan.2022.15},
	abstract = {Previous research on emotional language relied heavily on off-the-shelf sentiment dictionaries that focus on negative and positive tone. These dictionaries are often tailored to nonpolitical domains and use bag-of-words approaches which come with a series of disadvantages. This paper creates, validates, and compares the performance of (1) a novel emotional dictionary specifically for political text, (2) locally trained word embedding models combined with simple neural network classifiers, and (3) transformer-based models which overcome limitations of the dictionary approach. All tools can measure emotional appeals associated with eight discrete emotions. The different approaches are validated on different sets of crowd-coded sentences. Encouragingly, the results highlight the strengths of novel transformer-based models, which come with easily available pretrained language models. Furthermore, all customized approaches outperform widely used off-the-shelf dictionaries in measuring emotional language in German political discourse.},
	language = {en},
	urldate = {2023-07-19},
	journal = {Political Analysis},
	publisher = {Cambridge University Press},
	author = {Widmann, Tobias and Wich, Maximilian},
	month = jun,
	year = {2022},
	keywords = {emotions, read, dictionary, political text, text-as-data, transformer models, word embeddings},
	pages = {1--16},
	file = {Full Text PDF:C\:\\Users\\luehrija\\Zotero\\storage\\GTUFZCDM\\Widmann and Wich - 2022 - Creating and Comparing Dictionary, Word Embedding,.pdf:application/pdf},
}

@article{imhoffConspiracyMentalityPolitical2022,
	title = {Conspiracy mentality and political orientation across 26 countries},
	issn = {2397-3374},
	url = {https://www.nature.com/articles/s41562-021-01258-7},
	doi = {10.1038/s41562-021-01258-7},
	language = {en},
	urldate = {2022-01-19},
	journal = {Nature Human Behaviour},
	author = {Imhoff, Roland and Zimmer, Felix and Klein, Olivier and António, João H. C. and Babinska, Maria and Bangerter, Adrian and Bilewicz, Michal and Blanuša, Nebojša and Bovan, Kosta and Bužarovska, Rumena and Cichocka, Aleksandra and Delouvée, Sylvain and Douglas, Karen M. and Dyrendal, Asbjørn and Etienne, Tom and Gjoneska, Biljana and Graf, Sylvie and Gualda, Estrella and Hirschberger, Gilad and Kende, Anna and Kutiyski, Yordan and Krekó, Peter and Krouwel, Andre and Mari, Silvia and Đorđević, Jasna Milošević and Panasiti, Maria Serena and Pantazi, Myrto and Petkovski, Ljupcho and Porciello, Giuseppina and Rabelo, André and Radu, Raluca Nicoleta and Sava, Florin A. and Schepisi, Michael and Sutton, Robbie M. and Swami, Viren and Thórisdóttir, Hulda and Turjačanin, Vladimir and Wagner-Egger, Pascal and Žeželj, Iris and van Prooijen, Jan-Willem},
	month = jan,
	year = {2022},
	keywords = {read, conspiracy belief, conspiracy mentality, cross-national, political control deprivation, political orientation, power, survey},
	annote = {Summary: In two cross-national studies spanning 26 studies (N=104,253), the authors examine the relationship between conspiracy mentality and political orientation. They find support for a curvilinear relation, i.e. conspiracy mentality is associated with extreme left- and especially extreme right-wing beliefs (particularly voters of traditional, nationalistic and authoritarian parties). This relation is strengthened by deprivation of political control, e.g., among voters of opposition parties.
---{\textgreater} largest investigation of conspiracy mentality in terms of number of participants and included countries to date
Theoretical reasons for curvilinear relation:
1. "worldview explanation" = extreme political ideologies (both left and right) share a tendency to distrust and reject opposing ideas and associated groups; "Manichaean demonization of ideological outgroups which are presented not only as wrong but as immoral and dangerous"
- similar to conspiracy theories that are often authoritarian, forbid other views
- share an affinity to a belief in simple solutions
- across time and cultures, conspiracy theories are more or less universal in the discourse of extremist fringe groups independent of ideology
---{\textgreater} this general outlook on the world also determines one's political preferences
2. political control deprivation = "when people feel locked out of power, they may be more motivated to endorse beliefs that delegitimize incumbent authorities and the outcomes of political processes" (p. 2)
---{\textgreater} conspiracy belief is a reaction to the fact that one's political ideas are not part of the political mainstream
 
Methods
- Study 1 (N=33,431, July 2017): political orientation, conspiracy mentality \& political control deprivation in 23 countries
- Study 2 (N=70,882, Spring 2018): larger samples from 13 European countries that allowed weighting of data to match population-based distributions of age, gender, education and political leaning
- conspiracy mentality measurement = Conspiracy Mentality Questionnaire (CMQ) does not mention concrete people or events, thus, it is without political biases and can be used cross-nationally
- triangulated political orientation measurement:       a) extremely left-extremely right scale       b) voting intentions for political parties (hypothetical voting intentions: study 1; party they had voted for at the last national elections: study 2)
Results:
- self-reported pol. orientation: stronger positive correlation at the political right in centre-North of Europe (Austria), while centre-South of Europe was stronger on the left -{\textgreater} some heterogeneity across countries
- overall, the extreme right were more prone to conspiracy mentality and especially when their party is not in power
- supporters of parties not included in the government had higher levels of conspiracy mentality, but controlling for this still leaves thee effect of political orientation intact
---{\textgreater} individual levels of conspiracy mentality are at least partly associated with one's general worldview
- greater conspiracy mentality among supporters of social (but not economic) right-wing political orientation
- greater conspiracy mentality among people with lower levels of education
Limitations
- small effect sizes: supporting a non-governmental party and having a low education had substantially larger associations than either the linear of quadratic term of political orientation --{\textgreater} the association was modest 
- substantial heterogeneity across national contexts: linear relation ranged from strongly negative, e.g., Spain (more conspiracy mentality among self-reported leftists) to strongly positive, e.g., France/Poland/Sweden (more among the political right); while quadratic relation was more consistent across countries
- heterogeneity within countries (comparing study 1 \& 2): could be multiple reasons for this, e.g., different recruiting strategies and compositions of samples or these associations are more volatile than assumed --{\textgreater} pol. effects of events that had happened in the year between studies
 },
	file = {Imhoff et al. - 2022 - Conspiracy mentality and political orientation acr.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\8RQU5J7U\\Imhoff et al. - 2022 - Conspiracy mentality and political orientation acr.pdf:application/pdf},
}

