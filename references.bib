@misc{bak-colemanMovingInformativeActionable2025,
	title = {Moving towards informative and actionable social media research},
	url = {http://arxiv.org/abs/2505.09254},
	doi = {10.48550/arXiv.2505.09254},
	abstract = {Social media is nearly ubiquitous in modern life, and concerns have been raised about its putative societal impacts, ranging from undermining mental health and exacerbating polarization to fomenting violence and disrupting democracy. Despite extensive research, consensus on these effects remains elusive, with observational studies often highlighting concerns while randomized controlled trials (RCTs) yield conflicting or null findings. This review examines how the complexity inherent in social systems can account for such discrepancies, emphasizing that emergent societal and long-term outcomes cannot be readily inferred from individual-level effects. In complex systems, such as social networks, feedback loops, hysteresis, multi-scale dynamics, and non-linearity limit the utility of approaches for assessing causality that are otherwise robust in simpler contexts. Revisiting large-scale experiments, we explore how null or conflicting findings may reflect these complexities rather than a true absence of effects. Even in cases where the methods are appropriate, assessing the net impacts of social media provides little actionable insight given that eliminating social media is not a realistic option for whole populations. We argue that progress will require a complexity-minded approach focused on specific design choices of online platforms that triangulates experimental, observational and theoretical methods.},
	urldate = {2025-07-25},
	publisher = {arXiv},
	author = {Bak-Coleman, Joseph and Lorenz-Spreen, Philipp and Narayanan, Arvind and Orben, Amy and Oswald, Lisa},
	month = may,
	year = {2025},
	note = {arXiv:2505.09254 [cs]},
	keywords = {Computer Science - Social and Information Networks, read, Nonlinear Sciences - Adaptation and Self-Organizing Systems},
	annote = {Annotations(12/03/2026, 09:51:54)
“The inability to reach scientific consensus and provide actionable insight hints at the existence of deeper problems in the research endeavor that require resolution before progress can occur.” (Bak-Coleman et al., 2025, p. 3)
“First, social media constitute complex systems that comprise ensembles of individual elements that interact with each other in specific ways, thereby forming higher-level order and emergent phenomena on the collective level (12, 13).” (Bak-Coleman et al., 2025, p. 3)
“a complex systems approach” (Bak-Coleman et al., 2025, p. 4)
“suitable for estimating causal effects at a relevant scale” (Bak-Coleman et al., 2025, p. 4)
“observational causal inferences at levels of systemic complexity” (Bak-Coleman et al., 2025, p. 4)
“more detailed understanding of relationships between platform affordances and behaviors or attitudes” (Bak-Coleman et al., 2025, p. 4)
“Most conspicuously, individual-level RCTs cannot reliably yield the estimand of interest” (Bak-Coleman et al., 2025, p. 6)
“for most complex social phenomenon, such as the causal effect of social media on collective processes such as polarization, extremism, mental health trends or vaccine uptake” (Bak-Coleman et al., 2025, p. 7)
“This assumption that causal impacts at societal scales should be observable at the individual level is tenuous, specifically for studying the societal impact of social media, which is a quintessential example of a complex system” (Bak-Coleman et al., 2025, p. 7)
“Complex systems are defined by the way in which interactions lead to emergent phenomena such that the behavior of the system cannot be understood as the sum of its parts (cf., ”More is Different” (12)).” (Bak-Coleman et al., 2025, p. 7)
“any estimated quantity is not independent of the point in time and historical state” (Bak-Coleman et al., 2025, p. 7)
“In each of these cases, the outcome of interest cannot be isolated to individuals as the impacts of the treatment alter the system as a whole, in turn altering outcomes for both treatment and control groups alike” (Bak-Coleman et al., 2025, p. 8) collective anger because of ppl fighting
“The third problem associated with interpreting individual-level RCTs is that the effects may unfold non-monotonically over time and depend on both the state of other variables in the system and the moment of observation (Figure 1C).” (Bak-Coleman et al., 2025, p. 9)
“Finally, perhaps the core reason why RCTs are an inappropriate tool to study macrooutcomes on social media and power grids alike is that in both cases the individual units interact (Figure 1D).” (Bak-Coleman et al., 2025, p. 10)
“Very often the identification of a causal mechanism requires a multitude of methods, for example by triangulating it from observational, experimental and theoretical angles (46). We explore examples of this problem using several recent studies in depth in the next section.” (Bak-Coleman et al., 2025, p. 11)
“seek to identify realistic interventions concerning specific affordances of platforms that could actually be improved (15).” (Bak-Coleman et al., 2025, p. 14)
“time-dependent phenomena, such as feedback loops” (Bak-Coleman et al., 2025, p. 14)
“It is important to note, however, that that misunderstandings regarding the intrinsic causality of RCTs has a flip-side for observational work, where it is assumed they can solely produce associational or correlational evidence. Both misunderstandings arise from believing that a method imbues causality, when causality is instead a product of the assumptions we make about the associations we observe in our data both within and across studies (53).” (Bak-Coleman et al., 2025, p. 15)
“Techniques of causal inference from observational data leverage naturally-occurring, rather than experimentally induced variation (16).” (Bak-Coleman et al., 2025, p. 15)n
“effects estimated through instrumental-variable analyses is limited to a specific subpopulation (the “compliers”), as the analyses focus on the estimation of local average treatment effects (LATE), which can considerably reduce the generalizability of the findings to the population of interest.” (Bak-Coleman et al., 2025, p. 16)
“Field experiments” (Bak-Coleman et al., 2025, p. 16)
“atural experiments” (Bak-Coleman et al., 2025, p. 16)
“If observational approaches to causal inference reveal a trend, theoretical approaches can be used to propose how such trends might arise from mechanisms at play.” (Bak-Coleman et al., 2025, p. 17)
“The spread of misleading information online provides a salient example of how triangulation across observational and experimental research can be facilitated by complexity-minded theory.” (Bak-Coleman et al., 2025, p. 17)
“However, despite the success in RCTs and even convincing some platforms to adopt these approaches, estimating their population-level effect remains is not straightforward as the dynamics of misinformation spreading present a typical example of a complex, non-linear system (56).” (Bak-Coleman et al., 2025, p. 17)
“Yet misinformation spreads in a manner that can be captured by models of contagious processes (56).” (Bak-Coleman et al., 2025, p. 17)
“Disproportionate weight has been given to RCTs which, in failing to account for complexity, cannot yield the desired insight into impacts of platforms at societal scales.” (Bak-Coleman et al., 2025, p. 18)
“Such quantities are likely to be time-varying, hysteretic, and heterogeneous such that it is unlikely that we could come up with a single estimate of effects on any given domain of concern—much less across domains.” (Bak-Coleman et al., 2025, p. 19)
},
	file = {Preprint PDF:C\:\\Users\\luehrija\\Zotero\\storage\\GNV6LN92\\Bak-Coleman et al. - 2025 - Moving towards informative and actionable social m.pdf:application/pdf;Snapshot:C\:\\Users\\luehrija\\Zotero\\storage\\SHFNPNQT\\2505.html:text/html},
