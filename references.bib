@article{lindquistFunctionalArchitectureHuman2012,
	title = {A functional architecture of the human brain: emerging insights from the science of emotion},
	volume = {16},
	issn = {13646613},
	shorttitle = {A functional architecture of the human brain},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1364661312002215},
	doi = {10.1016/j.tics.2012.09.005},
	language = {en},
	number = {11},
	urldate = {2022-03-08},
	journal = {Trends in Cognitive Sciences},
	author = {Lindquist, Kristen A. and Barrett, Lisa Feldman},
	month = nov,
	year = {2012},
	keywords = {read},
	pages = {533--540},
	annote = {Faculty psychology vs. constructionism
- Faculty psychology: mental states or categories reflecting modular faculties like emotions can be mapped to the physical structure of body and brain
- constructionism: mental states can be mapped to the intrinsic networks in the brain and are constructed by out of the combination of more basic psychological operations or ingredients, i.e., core affect
- Neuroscience approach: there is no brain-based evidence for emotion faculties, i.e., while faculty psychology argues that increased activity in a given brain area corresponds with emotions, constructivists argue the following: “Rather than assuming that anger, disgust, fear, etc. are natural kind categories that are inborn and given by the structure of the brain and body, we propose that emotional experiences and perceptions are constructed from a set of more basic operations: sensations and feelings from the body (called core affect) and sensations from the world (exteroceptive sensations) that are made meaningful using past experience (conceptual knowledge), including knowledge about the emotion categories encoded in language [9,13].” (p. 534)
--{\textgreater} combination of brain networks (consistent with systems neuroscience approaches)
- Evidence supports “hypothesis that brain regions are implementing basic psychological operations that are not specific to any emotion per se, or even to the category ‘emotion’” (p. 535)- These basic psychological operations emerge from the interplay of neuron networks; here, networks are flexible assemblies of neurons that statistically fire together in a probabilistic way  neural model that hypothesizes emergentism 
“A constructionist approach requires that cognitive neuroscientists abandon the naive realist assumption that the structure of experience (emotions, cognitions, and perceptions) reveals causal mechanisms within the brain.” (p. 539)},
	file = {Lindquist and Barrett - 2012 - A functional architecture of the human brain emer.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\DL4HM3K2\\Lindquist and Barrett - 2012 - A functional architecture of the human brain emer.pdf:application/pdf},
}

@article{hickeyAuditingElonMusks2023,
	title = {Auditing {Elon} {Musk}’s {Impact} on {Hate} {Speech} and {Bots}},
