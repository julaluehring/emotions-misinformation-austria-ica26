@article{metzlerCollectiveEmotionsCOVID192023,
	title = {Collective emotions during the {COVID}-19 outbreak},
	volume = {23},
	issn = {1931-1516},
	doi = {10.1037/emo0001111},
	abstract = {The COVID-19 pandemic has exposed the world’s population to unprecedented health threats and changes to social life. High uncertainty about the novel disease and its social and economic consequences, together with increasingly stringent governmental measures against the spread of the virus, likely elicited strong emotional responses. We analyzed the digital traces of emotional expressions in tweets during 5 weeks after the start of outbreaks in 18 countries and six different languages. We observed an early strong upsurge of anxiety-related terms in all countries, which was related to the growth in cases and increases in the stringency of governmental measures. Anxiety expression gradually relaxed once stringent measures were in place, possibly indicating that people were reassured. Sadness terms rose and anger terms decreased with or after an increase in the stringency of measures and remained stable as long as measures were in place. Positive emotion words only decreased slightly and briefly in a few countries. Our results reveal some of the most enduring changes in emotional expression observed in long periods of social media data. Such sustained emotional expression could indicate that interactions between users led to the emergence of collective emotions. Words that frequently occurred in tweets suggest a shift in topics of conversation across all emotions, from political ones in 2019, to pandemic related issues during the outbreak, including everyday life changes, other people, and health. This kind of time-sensitive analyses of large-scale samples of emotional expression have the potential to inform risk communication. (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
	number = {3},
	journal = {Emotion},
	publisher = {American Psychological Association},
	author = {Metzler, Hannah and Rimé, Bernard and Pellert, Max and Niederkrotenthaler, Thomas and Di Natale, Anna and Garcia, David},
	year = {2023},
	note = {Place: US},
	keywords = {read, Anger, Emotions, COVID-19, Social Media, Economics, Emotionality (Personality), Pandemics, Psycholinguistics},
	pages = {844--858},
	file = {Snapshot:C\:\\Users\\luehrija\\Zotero\\storage\\2N72F9V5\\2022-77709-001.html:text/html;Submitted Version:C\:\\Users\\luehrija\\Zotero\\storage\\HZAKGZ26\\Metzler et al. - 2023 - Collective emotions during the COVID-19 outbreak.pdf:application/pdf},
}

@article{weeksEmotionsPartisanshipMisperceptions2015,
	title = {Emotions, {Partisanship}, and {Misperceptions}: {How} {Anger} and {Anxiety} {Moderate} the {Effect} of {Partisan} {Bias} on {Susceptibility} to {Political} {Misinformation}: {Emotions} and {Misperceptions}},
	volume = {65},
	issn = {00219916},
	shorttitle = {Emotions, {Partisanship}, and {Misperceptions}},
	url = {https://academic.oup.com/joc/article/65/4/699-719/4082338},
	doi = {10.1111/jcom.12164},
	abstract = {Citizens are frequently misinformed about political issues and candidates but the circumstances under which inaccurate beliefs emerge are not fully understood. This experimental study demonstrates that the independent experience of two emotions, anger and anxiety, in part determines whether citizens consider misinformation in a partisan or open-minded fashion. Anger encourages partisan, motivated evaluation of uncorrected misinformation that results in beliefs consistent with the supported political party, while anxiety at times promotes initial beliefs based less on partisanship and more on the information environment. However, exposure to corrections improves belief accuracy, regardless of emotion or partisanship. The results indicate that the unique experience of anger and anxiety can affect the accuracy of political beliefs by strengthening or attenuating the influence of partisanship.},
	language = {en},
	number = {4},
	urldate = {2022-01-17},
	journal = {Journal of Communication},
	author = {Weeks, Brian E.},
	month = aug,
	year = {2015},
	keywords = {emotions, read, anger, anxiety, belief accuracy, misinformation belief, misinformation correction, motivated reasoning, open-minded reasoning, partisan bias, partisanship},
	pages = {699--719},
	annote = {Relevant study about the role of anger \& anxiety in motivated reasoning in the context of political misinformation!
Findings
- anger exacerbates the influence of partisanship and makes participants more susceptible to party-consistent misinfo -{\textgreater} anger increases partisan-biased reasoning -{\textgreater} reinforcing effect on misinformation belief
--{\textgreater} political misperceptions are established and heightened
- anxiety lessens the influence of partisanship and increases the likelihood that a claim disseminated from the opposed political party is believed -{\textgreater} anxiety decreases partisan-biased reasoning -{\textgreater} facilitates open-mindedness and critical thinking, but it backfires when information is considered inaccurate or misleading -{\textgreater} less biased reasoning, but still effect on misinformation belief
Theory on anxiety \& anger
"Despite sharing a negative valence, the emotions anxiety and anger exhibit several distinct qualities that should lead to different responses to misinformation." (p. 701)
- anxiety is aversive, often triggered in response to threatening stimuli -{\textgreater} uncertainty, lack of control -{\textgreater} motivates behaviors that reduce anxiety -{\textgreater} political information-seeking, learning, deliberation, etc.
- anger is triggered when goals are blocked, when injustice or violation of standards occur -{\textgreater} certainty, individual control -{\textgreater} motivates behaviors that seek restitution -{\textgreater} closed-mindedness, defensive, causing harm, punishment
---{\textgreater} "These unique outcomes of anger and anxiety make it clear that conceptualizations of emotions need to move beyond positive or negative valence (Nabi, 2010)." (p. 702)
Methodology
- artificial emotion induction: people were asked to write something about either immigration reform or the death penalty that makes them either angry or anxious (2x2)
- control condition: people were asked to write about something that makes them relaxed
- random assignment to one of the 5 conditions (N=768)
- analysis: OLS regression with three-way interaction (emotion, partisanship, information environment)},
	file = {Weeks - 2015 - Emotions, Partisanship, and Misperceptions How An.pdf:C\:\\Users\\luehrija\\Zotero\\storage\\HSDP64DU\\Weeks - 2015 - Emotions, Partisanship, and Misperceptions How An.pdf:application/pdf},
}

@article{bierwiaczonekLonelinessTrajectoriesThree2024,
	title = {Loneliness trajectories over three decades are associated with conspiracist worldviews in midlife},
	volume = {15},
	copyright = {2024 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-024-47113-x},
	doi = {10.1038/s41467-024-47113-x},
	abstract = {In the age of misinformation, conspiracy theories can have far-reaching consequences for individuals and society. Social and emotional experiences throughout the life course, such as loneliness, may be associated with a tendency to hold conspiracist worldviews. Here, we present results from a population-based sample of Norwegians followed for almost three decades, from adolescence into midlife (N = 2215). We examine participants’ life trajectories of loneliness using latent growth curve modeling. We show that people reporting high levels of loneliness in adolescence, and those who experience increasing loneliness over the life course, are more likely to endorse conspiracy worldviews in midlife.},
	language = {en},
	number = {1},
